.vsp-row {
    flex-direction: row;
    align-items: center;
}

.vsp-grow {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.vsp-box {
    background-color: var(--unity-colors-helpbox-background);
    border-width: 1px;
    border-color: var(--unity-colors-helpbox-border);
    border-radius: 3px;
    padding: 3px 4px;
    margin: 2px 0;
}

.vsp-box-title {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.vsp-field-label {
    width: 100px;
    min-width: 100px;
    padding-left: 2px;
    -unity-text-align: middle-left;
}

.vsp-placeholder {
    background-color: var(--unity-colors-helpbox-background);
    border-radius: 3px;
    margin: 2px 0;
}

.vsp-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin: 0 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.vsp-icon-button {
    width: 20px;
    height: 18px;
    flex-shrink: 0;
    margin: 0 1px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    cursor: link;
}

.vsp-icon-button:hover:enabled {
    background-color: var(--unity-colors-button-background-hover);
}

.vsp-icon-button:disabled {
    opacity: 0.35;
}

.vsp-dropdown-button {
    width: 18px;
    min-width: 18px;
    height: 18px;
    margin: 0 1px;
    padding: 0;
    flex-shrink: 0;
}

.vsp-small-button {
    height: 18px;
    margin: 0 1px;
    padding: 0 4px;
    flex-shrink: 0;
}

.vsp-letter-toggle {
    width: 21px;
    min-width: 21px;
    height: 18px;
    margin: 0 0 0 2px;
    padding: 0;
    -unity-text-align: middle-center;
}

.vsp-letter-toggle--on {
    background-color: var(--unity-colors-button-background-pressed);
    border-color: var(--unity-colors-highlight-background);
}

.vsp-type-hint {
    color: rgb(128, 128, 128);
    -unity-font-style: italic;
    font-size: 10px;
    margin: 0 2px;
    flex-shrink: 0;
}

.vsp-footer {
    justify-content: flex-end;
    margin-top: 4px;
}

.vsp-footer-text,
.vsp-link {
    font-size: 10px;
    color: rgb(128, 128, 128);
    -unity-font-style: italic;
    padding: 0 2px;
}

.vsp-link {
    cursor: link;
}

.vsp-link:hover {
    color: rgb(77, 179, 255);
}

.vsp-avatar .unity-popup-field {
    margin: 0 2px 0 0;
}

.vsp-memory {
    margin: 2px 0 4px 0;
    min-height: 20px;
}

.vsp-memory--high .unity-progress-bar__progress {
    background-color: rgb(204, 140, 38);
}

.vsp-memory--over .unity-progress-bar__progress {
    background-color: rgb(204, 51, 51);
}

.vsp-search {
    width: auto;
    flex-grow: 1;
    margin: 2px 0;
}

.vsp-parameter-list {
    margin: 2px 0;
}

.vsp-cell {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    padding: 0 2px;
}

.vsp-cell--center {
    justify-content: center;
}

.vsp-cell .unity-base-field {
    margin: 0;
}

.vsp-cell--stretch .unity-base-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.vsp-name-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 40px;
    margin: 0 1px;
}

.vsp-cleanup {
    margin: 2px 0;
}

.vsp-cleanup Label {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.vsp-history-button {
    min-width: 26px;
    margin: 0 1px;
}

.vsp-history-title {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 1px;
    -unity-text-align: middle-center;
}

.vsp-parents-title {
    flex-grow: 1;
    -unity-font-style: bold;
    padding-left: 2px;
}

.vsp-parent-row {
    min-height: 18px;
}

.vsp-parent-button {
    margin: 1px 4px 1px 0;
    padding: 0 6px;
    flex-shrink: 0;
    cursor: link;
}

.vsp-parent-avatar {
    padding-left: 2px;
    -unity-font-style: italic;
}

.vsp-dim {
    color: rgb(128, 128, 128);
    -unity-font-style: italic;
    white-space: normal;
    flex-shrink: 1;
    padding-left: 2px;
}

.vsp-controls-title {
    flex-grow: 1;
    padding-left: 2px;
}

.vsp-control-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    padding: 0 2px;
}

.vsp-control-name {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    -unity-text-align: middle-left;
}

.vsp-control-row--unnamed .vsp-control-name {
    color: rgb(128, 128, 128);
    -unity-font-style: italic;
}

.vsp-control-type {
    color: rgb(128, 128, 128);
    -unity-font-style: italic;
    -unity-text-align: middle-right;
    margin-right: 4px;
}

.vsp-details {
    margin-top: 4px;
}

.vsp-parameter-field {
    margin: 1px 0;
}

.vsp-value-field {
    width: 50px;
    min-width: 50px;
    margin: 0 0 0 2px;
    flex-shrink: 0;
}

.vsp-icon-field {
    flex-shrink: 0;
    margin-left: 4px;
}

.vsp-icon-field .unity-object-field {
    margin: 0;
}

.vsp-icon-preview {
    background-color: var(--unity-colors-input_field-background);
    border-width: 1px;
    border-color: var(--unity-colors-input_field-border);
    border-radius: 2px;
    margin-bottom: 2px;
}

.vsp-axis-label {
    flex-grow: 1;
    flex-basis: 0;
    margin: 2px;
}

.vsp-axis-caption {
    color: rgb(128, 128, 128);
    margin-bottom: 2px;
}

.vsp-compact-label {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 2px;
}

.vsp-compact-label .unity-object-field {
    width: 70px;
    margin: 0 0 0 2px;
}
